{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v57.local/schema/package.schema.json",
  "title": "V57 package",
  "description": "Project identity for V57 (brief §2). Generated by intake from TDD §A/§2/§11 + README.",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "genre": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "perspective": {
      "enum": [
        "2d",
        "2.5d",
        "3d"
      ]
    },
    "physics": {
      "enum": [
        "2d",
        "3d"
      ]
    },
    "players": {
      "type": "integer",
      "minimum": 1
    },
    "engine": {
      "type": "object",
      "properties": {
        "unity_pinned": {
          "type": "string"
        },
        "tdd_declared": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "unity_pinned",
        "tdd_declared"
      ]
    },
    "platform": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "reference_resolution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "target_fps": {
          "type": "integer"
        }
      },
      "required": [
        "targets",
        "orientation",
        "reference_resolution",
        "target_fps"
      ]
    },
    "world": {
      "type": "object",
      "properties": {
        "units": {
          "const": "meters"
        },
        "up": {
          "const": "Y"
        },
        "forward": {
          "const": "Z"
        },
        "play_area_m": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        }
      },
      "required": [
        "units",
        "up",
        "forward",
        "play_area_m"
      ]
    },
    "slice": {
      "type": "object",
      "properties": {
        "scenes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "gold_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "scenes",
        "gold_path"
      ]
    },
    "sources": {
      "type": "object",
      "properties": {
        "tdd": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "add": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          ]
        }
      },
      "required": [
        "tdd",
        "add"
      ]
    }
  },
  "required": [
    "slug",
    "title",
    "version",
    "genre",
    "modules",
    "perspective",
    "physics",
    "players",
    "engine",
    "platform",
    "world",
    "slice",
    "sources"
  ],
  "additionalProperties": false
}
