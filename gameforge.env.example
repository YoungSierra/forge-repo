# At least one API key is required for Generate/Chat.
# Preferred location: %USERPROFILE%\.v57\gameforge.env
# Alternative: project .env.local (gitignored)
# Never put keys under Assets/ or Packages/.

CURSOR_API_KEY=
CURSOR_MODEL=auto
AGENT_PROVIDER=cursor

