{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://base-unity-v57.local/schema/feature-spec.schema.json",
  "title": "V57 Feature Spec",
  "type": "object",
  "required": ["specVersion", "name", "type", "dependencies", "components", "acceptanceCriteria", "validationGates"],
  "properties": {
    "specVersion": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "enum": ["feature", "system", "mechanic"] },
    "description": { "type": "string" },
    "version": { "type": ["string", "number"] },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": { "enum": ["feature", "system", "mechanic"] },
          "id": { "type": "string" },
          "minVersion": { "type": ["string", "null"] }
        }
      }
    },
    "components": { "type": "array" },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "traceTo": { "type": "string" }
        }
      }
    },
    "validationGates": { "type": "object" },
    "specId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "touches": {
      "type": "object",
      "properties": {
        "scripts": { "type": "array", "items": { "type": "string" } },
        "prefabs": { "type": "array", "items": { "type": "string" } },
        "scriptable_objects": { "type": "array", "items": { "type": "string" } },
        "scenes": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } }
      }
    },
    "eventChannels": { "type": "array" }
  },
  "additionalProperties": true
}
