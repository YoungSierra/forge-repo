/* Professor Wort & Sprat — UI Toolkit styles from the TDD §8 palette. Text only until UI art is delivered. */
:root {
    --amber: #FF8C00;
    --ocean: #0A1F3C;
    --rust: #4A3728;
    --cyan: #00E5FF;
    --caution: #FFD600;
    --white: #FFFFFF;
}

.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.hud { padding: 32px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.hud-counter {
    font-size: 56px; -unity-font-style: bold; color: var(--cyan);
    background-color: rgba(10, 31, 60, 0.75); border-radius: 16px; padding: 8px 24px;
    -unity-text-outline-width: 1px; -unity-text-outline-color: var(--ocean);
}
.hud-counter--last { color: var(--caution); }
.key-glyph { background-color: rgba(10, 31, 60, 0.75); border-radius: 16px; padding: 8px 20px; }
.key-glyph Label { font-size: 40px; -unity-font-style: bold; color: var(--amber); }

.panel {
    position: absolute; left: 30%; right: 30%; top: 22%;
    background-color: rgba(10, 31, 60, 0.92); border-radius: 24px; padding: 40px;
    border-width: 4px; border-color: var(--amber); align-items: stretch;
}
.panel-title { font-size: 48px; -unity-font-style: bold; color: var(--white); -unity-text-align: middle-center; margin-bottom: 24px; }
.panel-text { font-size: 30px; color: var(--white); -unity-text-align: middle-center; margin-bottom: 24px; white-space: normal; }
.menu-button {
    font-size: 32px; color: var(--ocean); background-color: var(--white); border-radius: 12px;
    margin: 8px 0; padding: 12px; -unity-font-style: bold; border-width: 0;
}
.menu-button:hover, .menu-button:focus { background-color: var(--amber); color: var(--white); }

.loading-cover { background-color: rgb(0, 0, 0); }
.title { font-size: 72px; -unity-font-style: bold; color: var(--amber); -unity-text-align: middle-center; margin-bottom: 40px; }
.menu-root { background-color: var(--ocean); justify-content: center; align-items: center; }
.menu-column { width: 520px; }
