# Texto: fin de línea normalizado
* text=auto
*.md      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.csv     text eol=lf
*.txt     text eol=lf
*.cs      text eol=lf diff=csharp
*.shader  text eol=lf
*.hlsl    text eol=lf
*.uss     text eol=lf
*.uxml    text eol=lf
*.asmdef  text eol=lf
*.inputactions text eol=lf

# Unity YAML (los crea V57): merge inteligente
*.meta     text eol=lf
*.unity    text eol=lf merge=unityyamlmerge
*.prefab   text eol=lf merge=unityyamlmerge
*.asset    text eol=lf merge=unityyamlmerge
*.mat      text eol=lf merge=unityyamlmerge
*.anim     text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge
*.spriteatlasv2 text eol=lf merge=unityyamlmerge
# Terrain y NavMesh se corrompen con conversión de fin de línea
*.terrainlayer binary
**/TerrainData*.asset binary
**/NavMesh*.asset binary

# ---- Binarios en Git LFS ----
