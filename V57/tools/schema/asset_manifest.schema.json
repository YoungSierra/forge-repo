{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v57.local/schema/asset_manifest.schema.json",
  "title": "V57 asset manifest",
  "description": "ADD asset_briefs x on-disk inventory (brief 00a72).",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "asset_name": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "model",
              "character",
              "animation",
              "texture",
              "sprite",
              "atlas",
              "font",
              "vfx",
              "music",
              "sfx",
              "ambience",
              "voice",
              "blockout",
              "reference"
            ]
          },
          "serves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "object"
          },
          "size_m": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            ]
          },
          "pivot": {
            "enum": [
              null,
              "feet",
              "base",
              "center",
              "hinge",
              "axle"
            ]
          },
          "side": {
            "enum": [
              null,
              "left",
              "right",
              "center"
            ]
          },
          "collision": {
            "enum": [
              "none",
              "simple",
              "exact",
              "mesh",
              "convex"
            ],
            "description": "Brief collision, or a Docs/V57/asset_rules.json override (mesh = non-convex mesh colliders on LOD0, convex = convex mesh colliders)."
          },
          "tris_lod0": {
            "type": [
              "number",
              "null"
            ]
          },
          "texture_size": {
            "type": [
              "number",
              "null"
            ]
          },
          "bones": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "enum": [
              "final",
              "provisional"
            ]
          },
          "source": {
            "enum": [
              "brief",
              "inventory"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rig": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "humanoid",
              "generic",
              null
            ]
          },
          "shadows": {
            "enum": [
              "on",
              "off",
              "two_sided"
            ],
            "description": "asset_rules: renderer shadow casting (two_sided for single-sided pieces placed flipped, e.g. roofs)."
          },
          "shader": {
            "type": "string",
            "description": "asset_rules: game shader the generated material keeps (Lit-compatible properties)."
          },
          "attach": {
            "type": "array",
            "description": "asset_rules: prefabs placed with every layout instance of the asset.",
            "items": {
              "type": "object",
              "properties": {
                "prefab": {
                  "type": "string"
                },
                "offset": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "align": {
                  "enum": [
                    "world",
                    "instance"
                  ]
                }
              },
              "required": [
                "prefab",
                "offset",
                "align"
              ],
              "additionalProperties": false
            }
          },
          "ruled": {
            "type": "boolean",
            "description": "true when a Docs/V57/asset_rules.json rule matched; the assembly then keeps the kept Visual prefab in sync with it (colliders, shadows) on every build."
          }
        },
        "required": [
          "asset_id",
          "asset_name",
          "category",
          "type",
          "serves",
          "files",
          "size_m",
          "pivot",
          "side",
          "collision",
          "tris_lod0",
          "texture_size",
          "bones",
          "status",
          "source",
          "issues",
          "rig"
        ]
      }
    },
    "orphans": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "assets",
    "orphans"
  ],
  "additionalProperties": false
}
